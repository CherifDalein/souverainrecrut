# ==========================================================
# Modèle de configuration – copier en .env sur le serveur
# Le vrai .env n'est JAMAIS commité : il est généré par le
# pipeline GitLab à partir des variables CI/CD masquées.
# ==========================================================

# Isolation de l'environnement (réseau, volume et conteneurs préfixés)
COMPOSE_PROJECT_NAME=souverainrecrut-staging

# Image publiée par Jenkins sur Docker Hub
BACKEND_IMAGE=cherifdiallo725/souverainrecrut-backend
IMAGE_TAG=sha-xxxxxxx

# Port exposé de l'API sur le serveur (staging 4001, prod 4000)
API_PORT=4001

# Base de données
POSTGRES_DB=souverainrecrut
POSTGRES_USER=souverainrecrut
POSTGRES_PASSWORD=a-remplacer

# Application
JWT_SECRET=a-remplacer-par-une-valeur-longue-et-aleatoire
API_VERSION=v1
FRONTEND_URL=http://localhost:5173
